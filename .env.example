# Публичный адрес сайта — используется в canonical, hreflang, sitemap и og:image
NEXT_PUBLIC_SITE_URL=https://nukus-uzdsmi.uz

# PostgreSQL. Пустое значение = сайт работает на демо-контенте без базы
DATABASE_URI=postgres://nukus:nukus@postgres:5432/nukus_uzdsmi

# Секрет Payload: подписывает токены и куки админки. Обязательно заменить.
PAYLOAD_SECRET=change-me-please-32-chars-minimum

# Каталоги медиатеки внутри контейнера (монтируются томом)
PAYLOAD_MEDIA_DIR=public/media/uploads
PAYLOAD_DOCS_DIR=public/documents
